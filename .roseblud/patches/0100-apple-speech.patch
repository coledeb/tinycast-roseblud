diff --git a/Tests/DictationTranscriptTests.swift b/Tests/DictationTranscriptTests.swift
new file mode 100644
index 0000000000000000000000000000000000000000..59028d4d4893b9a26b33b19e27b8ef90246b11a6
--- /dev/null
+++ b/Tests/DictationTranscriptTests.swift
@@ -0,0 +1,43 @@
+import Foundation
+
+@main
+struct DictationTranscriptTests {
+    static func main() {
+        func check<T: Equatable>(_ actual: T, _ expected: T, _ label: String) {
+            guard actual == expected else {
+                print("\(label): expected \(expected), got \(actual)")
+                exit(1)
+            }
+        }
+
+        var transcript = DictationTranscript()
+        check(transcript.isEmpty, true, "starts empty")
+        transcript.apply(" Hello", isFinal: false)
+        check(transcript.volatile, "Hello", "a guess is trimmed")
+        check(transcript.undelivered, "", "a guess is never deliverable")
+        transcript.apply("Hello there", isFinal: false)
+        check(transcript.volatile, "Hello there", "a newer guess replaces the last")
+        transcript.apply("Hello there.", isFinal: true)
+        check(transcript.finalized, "Hello there.", "a final result settles")
+        check(transcript.volatile, "", "settling drops the guess")
+        transcript.apply("How", isFinal: false)
+        check(transcript.tail(limit: 100).text, "Hello there. How", "tail joins settled and guess")
+        check(transcript.tail(limit: 100).settled, 12, "settled count stops at the guess")
+
+        check(transcript.takeUndelivered(), "Hello there.", "settled text is taken once")
+        check(transcript.takeUndelivered(), "", "taking again yields nothing")
+        transcript.apply("How are you", isFinal: true)
+        transcript.apply(", friend?", isFinal: true)
+        check(transcript.finalized, "Hello there. How are you, friend?", "punctuation glues without a space")
+        check(transcript.takeUndelivered(), "How are you, friend?", "only the new span is taken")
+
+        var long = DictationTranscript()
+        long.apply("one two three four five six", isFinal: true)
+        long.apply("seven", isFinal: false)
+        let tail = long.tail(limit: 12)
+        check(tail.text, "six seven", "a tail starts at a whole word")
+        check(tail.settled, 3, "the tail's settled count shifts with the cut")
+
+        print("Dictation transcript passed")
+    }
+}
diff --git a/Tinycast/Features/Dictation/Model/DictationTranscript.swift b/Tinycast/Features/Dictation/Model/DictationTranscript.swift
new file mode 100644
index 0000000000000000000000000000000000000000..a68e78c911348b76fc2b76027dc6765173252d41
--- /dev/null
+++ b/Tinycast/Features/Dictation/Model/DictationTranscript.swift
@@ -0,0 +1,53 @@
+import Foundation
+
+/// The text of one dictation as it streams in: settled text, the recognizer's current guess, and how
+/// much of the settled text has already been delivered.
+struct DictationTranscript: Equatable, Sendable {
+    private(set) var finalized = ""
+    private(set) var volatile = ""
+    private var delivered = 0
+
+    var isEmpty: Bool { finalized.isEmpty && volatile.isEmpty }
+
+    /// Settled text not yet taken, without surrounding whitespace.
+    var undelivered: String {
+        String(finalized.dropFirst(delivered)).trimmingCharacters(in: .whitespacesAndNewlines)
+    }
+
+    /// A final result settles its span and drops the guess it replaces; a volatile one replaces the guess.
+    mutating func apply(_ text: String, isFinal: Bool) {
+        let piece = text.trimmingCharacters(in: .whitespacesAndNewlines)
+        guard isFinal else {
+            volatile = piece
+            return
+        }
+        volatile = ""
+        finalized = Self.joined(finalized, piece)
+    }
+
+    mutating func takeUndelivered() -> String {
+        let text = undelivered
+        delivered = finalized.count
+        return text
+    }
+
+    /// The last `limit` characters of settled and guessed text, cut at a word so the bubble never
+    /// opens mid-word. `settled` counts how many of them are settled.
+    func tail(limit: Int) -> (text: String, settled: Int) {
+        let whole = Self.joined(finalized, volatile)
+        let settled = min(finalized.count, whole.count)
+        guard whole.count > limit else { return (whole, settled) }
+        var start = whole.index(whole.endIndex, offsetBy: -limit)
+        if let space = whole[start...].firstIndex(where: \.isWhitespace) {
+            start = whole.index(after: space)
+        }
+        let dropped = whole.distance(from: whole.startIndex, to: start)
+        return (String(whole[start...]), max(0, settled - dropped))
+    }
+
+    private static func joined(_ head: String, _ next: String) -> String {
+        guard !head.isEmpty, !next.isEmpty else { return head + next }
+        let glued = head.last?.isWhitespace == true || next.first.map { ".,!?;:)]}".contains($0) } == true
+        return glued ? head + next : head + " " + next
+    }
+}
diff --git a/Tinycast/Features/Dictation/Service/DictationAppleSpeech.swift b/Tinycast/Features/Dictation/Service/DictationAppleSpeech.swift
new file mode 100644
index 0000000000000000000000000000000000000000..d928ebc116d89b7c7fc727e44cee713cb79e1a35
--- /dev/null
+++ b/Tinycast/Features/Dictation/Service/DictationAppleSpeech.swift
@@ -0,0 +1,187 @@
+import AVFoundation
+import Speech
+
+/// Apple's on-device recognizer for one dictation: captured samples in, volatile and final text out.
+/// It runs in the app, not the helper: the analyzer is a system service with no model of ours to isolate.
+@MainActor
+final class DictationAppleSpeech {
+    enum Failure: LocalizedError {
+        case unsupportedLocale
+        case notInstalled
+        case audioFormat
+
+        var errorDescription: String? {
+            switch self {
+            case .unsupportedLocale:
+                String(localized: "Apple's speech recognition doesn't support your system language.")
+            case .notInstalled: String(localized: "Install Apple's speech model in Dictation settings first.")
+            case .audioFormat: String(localized: "Couldn't start Apple's speech recognition.")
+            }
+        }
+    }
+
+    static let engineKey = "rosebludDictationEngine"
+    static let liveTranscriptKey = "rosebludDictationLiveTranscript"
+    static var isSelected: Bool { UserDefaults.standard.string(forKey: engineKey) == "apple" }
+    static var showsLiveTranscript: Bool {
+        UserDefaults.standard.object(forKey: liveTranscriptKey) as? Bool ?? true
+    }
+
+    /// Called on the capture queue; the stream holds samples until the analyzer knows its format.
+    nonisolated let sampleTap: @Sendable (UnsafeBufferPointer<Float>) -> Void
+    private let samples: AsyncStream<[Float]>
+    private let sampleSink: AsyncStream<[Float]>.Continuation
+    private var task: Task<Void, Never>?
+    private var analyzer: SpeechAnalyzer?
+
+    init() {
+        let (samples, sink) = AsyncStream.makeStream(of: [Float].self)
+        self.samples = samples
+        sampleSink = sink
+        sampleTap = { sink.yield(Array($0)) }
+    }
+
+    static func locale() async -> Locale? {
+        await SpeechTranscriber.supportedLocale(equivalentTo: .current)
+    }
+
+    static func isInstalled() async -> Bool {
+        guard let locale = await locale() else { return false }
+        let wanted = locale.identifier(.bcp47)
+        return await SpeechTranscriber.installedLocales.contains { $0.identifier(.bcp47) == wanted }
+    }
+
+    static func install() async throws {
+        guard let locale = await locale() else { throw Failure.unsupportedLocale }
+        let module = SpeechTranscriber(locale: locale, preset: .transcription)
+        try await AssetInventory.assetInstallationRequest(supporting: [module])?.downloadAndInstall()
+    }
+
+    /// `onResult` receives each result in order; a final one settles its span of audio.
+    func start(
+        onResult: @escaping (_ text: String, _ isFinal: Bool) -> Void,
+        onFailure: @escaping (any Error) -> Void
+    ) {
+        let samples = samples
+        task = Task { [weak self] in
+            do {
+                guard let locale = await Self.locale() else { throw Failure.unsupportedLocale }
+                guard await Self.isInstalled() else { throw Failure.notInstalled }
+                let transcriber = SpeechTranscriber(
+                    locale: locale, transcriptionOptions: [],
+                    reportingOptions: [.volatileResults, .fastResults], attributeOptions: [])
+                guard
+                    let format = await SpeechAnalyzer.bestAvailableAudioFormat(compatibleWith: [transcriber])
+                else { throw Failure.audioFormat }
+                let analyzer = SpeechAnalyzer(modules: [transcriber])
+                guard let self, !Task.isCancelled else { return }
+                self.analyzer = analyzer
+                try await analyzer.prepareToAnalyze(in: format)
+                let (inputs, inputSink) = AsyncStream.makeStream(of: AnalyzerInput.self)
+                try await analyzer.start(inputSequence: inputs)
+                async let fed: Void = Self.feed(samples, into: inputSink, format: format, analyzer: analyzer)
+                for try await result in transcriber.results {
+                    onResult(String(result.text.characters), result.isFinal)
+                }
+                try await fed
+            } catch {
+                guard !Task.isCancelled, !(error is CancellationError) else { return }
+                onFailure(error)
+            }
+        }
+    }
+
+    /// Ends the input and waits for the analyzer to settle every result still pending.
+    func finish() async {
+        sampleSink.finish()
+        await task?.value
+    }
+
+    func cancel() {
+        sampleSink.finish()
+        task?.cancel()
+        task = nil
+        guard let analyzer else { return }
+        self.analyzer = nil
+        Task { await analyzer.cancelAndFinishNow() }
+    }
+
+    @concurrent
+    private static func feed(
+        _ samples: AsyncStream<[Float]>, into sink: AsyncStream<AnalyzerInput>.Continuation,
+        format: AVAudioFormat, analyzer: SpeechAnalyzer
+    ) async throws {
+        guard
+            let source = AVAudioFormat(
+                commonFormat: .pcmFormatFloat32, sampleRate: Double(DictationWire.sampleRate),
+                channels: 1, interleaved: false)
+        else { throw Failure.audioFormat }
+        do {
+            // nil only when no conversion is needed; a converter that can't be made is a failure.
+            var converter: AVAudioConverter?
+            if source != format {
+                guard let made = AVAudioConverter(from: source, to: format) else { throw Failure.audioFormat }
+                converter = made
+            }
+            for await chunk in samples {
+                guard let buffer = pcmBuffer(chunk, format: source) else { continue }
+                guard let converter else {
+                    sink.yield(AnalyzerInput(buffer: buffer))
+                    continue
+                }
+                if let converted = try convert(buffer, with: converter) {
+                    sink.yield(AnalyzerInput(buffer: converted))
+                }
+            }
+        } catch {
+            // Ends the results too, so the caller's loop returns and reports this error.
+            sink.finish()
+            await analyzer.cancelAndFinishNow()
+            throw error
+        }
+        sink.finish()
+        try await analyzer.finalizeAndFinishThroughEndOfInput()
+    }
+
+    private nonisolated static func pcmBuffer(_ samples: [Float], format: AVAudioFormat) -> AVAudioPCMBuffer? {
+        guard !samples.isEmpty,
+            let buffer = AVAudioPCMBuffer(pcmFormat: format, frameCapacity: AVAudioFrameCount(samples.count)),
+            let channel = buffer.floatChannelData?[0]
+        else { return nil }
+        samples.withUnsafeBufferPointer { channel.update(from: $0.baseAddress!, count: samples.count) }
+        buffer.frameLength = AVAudioFrameCount(samples.count)
+        return buffer
+    }
+
+    private nonisolated static func convert(
+        _ buffer: AVAudioPCMBuffer, with converter: AVAudioConverter
+    ) throws -> AVAudioPCMBuffer? {
+        let ratio = converter.outputFormat.sampleRate / converter.inputFormat.sampleRate
+        let capacity = AVAudioFrameCount((Double(buffer.frameLength) * ratio).rounded(.up)) + 1
+        guard let output = AVAudioPCMBuffer(pcmFormat: converter.outputFormat, frameCapacity: capacity)
+        else { throw Failure.audioFormat }
+        let input = OneShotInput(buffer)
+        var error: NSError?
+        let status = converter.convert(to: output, error: &error) { _, outStatus in input.next(outStatus) }
+        if status == .error { throw error ?? Failure.audioFormat }
+        // No frames yet is ordinary: the converter holds a few samples back until the next buffer.
+        return output.frameLength > 0 ? output : nil
+    }
+}
+
+/// Hands the converter one buffer, then reports no data until the next call, so it keeps its state.
+private final class OneShotInput: @unchecked Sendable {
+    private var buffer: AVAudioPCMBuffer?
+
+    init(_ buffer: AVAudioPCMBuffer) { self.buffer = buffer }
+
+    func next(_ status: UnsafeMutablePointer<AVAudioConverterInputStatus>) -> AVAudioBuffer? {
+        guard let buffer else {
+            status.pointee = .noDataNow
+            return nil
+        }
+        self.buffer = nil
+        status.pointee = .haveData
+        return buffer
+    }
+}
