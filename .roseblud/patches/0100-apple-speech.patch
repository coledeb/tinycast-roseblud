+                }
+            },
+            onFailed: { [weak self] in
+                guard let self, token == current else { return }
+                reset(cancelTranscription: false)
+                if destination.copies { Paster.copyPlainText(assembled) }
+                showMessage(String(localized: "Couldn't paste dictation into this app"), .danger)
+            })
+    }
+}
diff --git a/Tinycast/Features/Dictation/Service/DictationStreaming.swift b/Tinycast/Features/Dictation/Service/DictationStreaming.swift
new file mode 100644
index 0000000000000000000000000000000000000000..ccf02274152a3b73786f54f0636aa55dfaa3f612
--- /dev/null
+++ b/Tinycast/Features/Dictation/Service/DictationStreaming.swift
@@ -0,0 +1,53 @@
+import Foundation
+
+/// One dictation's streamed text, Apple's recognizer when it is the engine, and the bubble showing both.
+@MainActor
+final class DictationStreaming {
+    static var usesAppleSpeech: Bool { DictationAppleSpeech.isSelected }
+
+    private let bubble = DictationTranscriptBubble()
+    private var transcript = DictationTranscript()
+    private var apple: DictationAppleSpeech?
+
+    var isApple: Bool { apple != nil }
+
+    /// Without Apple's recognizer the capture keeps no tap, so a chunked session pays nothing for it.
+    func begin(
+        apple useApple: Bool, capture: DictationCapture,
+        onResult: @escaping (_ text: String, _ isFinal: Bool) -> Void,
+        onFailure: @escaping (any Error) -> Void
+    ) {
+        end()
+        guard useApple else {
+            capture.onSamples = nil
+            return
+        }
+        let apple = DictationAppleSpeech()
+        self.apple = apple
+        capture.onSamples = apple.sampleTap
+        apple.start(onResult: onResult, onFailure: onFailure)
+    }
+
+    func apply(_ text: String, isFinal: Bool) {
+        transcript.apply(text, isFinal: isFinal)
+        show()
+    }
+
+    func takeSettled() -> String { transcript.takeUndelivered() }
+
+    func finish() async { await apple?.finish() }
+
+    func closeBubble() { bubble.close() }
+
+    func end() {
+        apple?.cancel()
+        apple = nil
+        transcript = DictationTranscript()
+        bubble.close()
+    }
+
+    private func show() {
+        guard DictationAppleSpeech.showsLiveTranscript else { return }
+        bubble.show(transcript)
+    }
+}
diff --git a/Tinycast/Features/Dictation/Settings/DictationAppleSpeechSection.swift b/Tinycast/Features/Dictation/Settings/DictationAppleSpeechSection.swift
new file mode 100644
index 0000000000000000000000000000000000000000..14fd6e01ef04a6266955ee6f23417c331ce5352b
--- /dev/null
+++ b/Tinycast/Features/Dictation/Settings/DictationAppleSpeechSection.swift
@@ -0,0 +1,83 @@
+import SwiftUI
+
+/// Chooses Apple's on-device recognizer over the downloaded models, and the live transcript bubble.
+struct DictationAppleSpeechSection: View {
+    private enum AssetState { case checking, unsupported, missing, installing, installed }
+
+    @AppStorage(DictationAppleSpeech.engineKey) private var engine = ""
+    @AppStorage(DictationAppleSpeech.liveTranscriptKey) private var showsLiveTranscript = true
+    @State private var assets = AssetState.checking
+    @State private var locale: Locale?
+    @State private var installError: String?
+
+    var body: some View {
+        Section {
+            Picker(selection: $engine) {
+                Text("Downloaded model").tag("")
+                Text(verbatim: "Apple SpeechAnalyzer").tag("apple")
+            } label: {
+                SettingsRowTitle(.dictationModel, "Recognizer")
+                Text(
+                    engine == "apple"
+                        ? "Built into macOS: nothing to download, words appear as you speak."
+                        : "Parakeet or Qwen, chosen below.")
+            }
+            if engine == "apple" {
+                LabeledContent {
+                    switch assets {
+                    case .checking, .installing: ProgressView().controlSize(.small)
+                    case .missing: Button("Install") { install() }
+                    case .unsupported, .installed: EmptyView()
+                    }
+                } label: {
+                    Text(assetTitle)
+                    if let detail = installError ?? locale.map(localeDescription) { Text(detail) }
+                }
+                Toggle(isOn: $showsLiveTranscript) {
+                    SettingsRowTitle(.dictationModel, "Show live transcript")
+                    Text("Words appear above the microphone as you speak.")
+                }
+            }
+        } header: {
+            Text("Recognizer")
+        }
+        .task(id: engine) { await refresh() }
+    }
+
+    private var assetTitle: String {
+        switch assets {
+        case .checking: String(localized: "Checking Apple's speech model…")
+        case .unsupported: String(localized: "Your system language isn't supported")
+        case .missing: String(localized: "Not installed")
+        case .installing: String(localized: "Installing…")
+        case .installed: String(localized: "Installed")
+        }
+    }
+
+    private func localeDescription(_ locale: Locale) -> String {
+        Locale.current.localizedString(forIdentifier: locale.identifier) ?? locale.identifier
+    }
+
+    private func refresh() async {
+        guard engine == "apple" else { return }
+        locale = await DictationAppleSpeech.locale()
+        guard locale != nil else {
+            assets = .unsupported
+            return
+        }
+        assets = await DictationAppleSpeech.isInstalled() ? .installed : .missing
+    }
+
+    private func install() {
+        assets = .installing
+        installError = nil
+        Task {
+            do {
+                try await DictationAppleSpeech.install()
+            } catch {
+                installError = error.localizedDescription
+            }
+            await refresh()
+        }
+    }
+}
