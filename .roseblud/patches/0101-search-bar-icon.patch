diff --git a/Tinycast/Features/Settings/Panes/SearchBarEmojiPicker.swift b/Tinycast/Features/Settings/Panes/SearchBarEmojiPicker.swift
new file mode 100644
index 0000000000000000000000000000000000000000..c16321021cc61156c46ac2caa913c43c3a08872d
--- /dev/null
+++ b/Tinycast/Features/Settings/Panes/SearchBarEmojiPicker.swift
@@ -0,0 +1,68 @@
+import SwiftUI
+
+/// tinycast-roseblud: the search bar icon's emoji popover, searched like the Emoji screen.
+struct SearchBarEmojiPicker: View {
+    let onPick: (String) -> Void
+    @Environment(AppCore.self) private var core
+    @Environment(AppSettings.self) private var settings
+    @State private var query = ""
+    @FocusState private var searchFocused: Bool
+
+    private static let columnCount = 8
+    private static let cell: CGFloat = 32
+    private static let height: CGFloat = 300
+
+    private var columns: [GridItem] {
+        Array(repeating: GridItem(.fixed(Self.cell), spacing: Theme.Spacing.sm), count: Self.columnCount)
+    }
+
+    var body: some View {
+        let results = results
+        return VStack(spacing: Theme.Spacing.md) {
+            // The popover inherits the Settings form's style, which right-aligns its fields.
+            TextField("", text: $query, prompt: Text("Search…"))
+                .labelsHidden()
+                .multilineTextAlignment(.leading)
+                .textFieldStyle(.roundedBorder)
+                .focused($searchFocused)
+                .onSubmit { results.first.map(pick) }
+            ScrollView {
+                LazyVGrid(columns: columns, spacing: Theme.Spacing.sm) {
+                    ForEach(results) { entry in
+                        Button { pick(entry) } label: {
+                            Text(verbatim: glyph(entry))
+                                .font(.system(size: 22))
+                                .frame(width: Self.cell, height: Self.cell)
+                                .contentShape(Rectangle())
+                        }
+                        .buttonStyle(.plain)
+                        .help(entry.displayName)
+                    }
+                }
+            }
+            .overlay {
+                if results.isEmpty { Text("No Results").foregroundStyle(.secondary) }
+            }
+        }
+        .padding(Theme.Spacing.md)
+        .frame(width: width, height: Self.height)
+        .onAppear { searchFocused = true }
+    }
+
+    private var width: CGFloat {
+        CGFloat(Self.columnCount) * (Self.cell + Theme.Spacing.sm) + Theme.Spacing.md * 2
+    }
+
+    /// Symbols and text-style characters share the catalog, but only an emoji may stand in the bar.
+    private var results: [EmojiEntry] {
+        let index = core.emojiIndex
+        let entries =
+            query.isEmpty
+            ? index.categorySections.flatMap(\.entries) : index.search(query, frequent: core.frequentEmoji)
+        return entries.filter { SearchBarIcon.emoji(in: $0.glyph) == $0.glyph }
+    }
+
+    private func glyph(_ entry: EmojiEntry) -> String { entry.display(tone: settings.emojiSkinTone) }
+
+    private func pick(_ entry: EmojiEntry) { onPick(glyph(entry)) }
+}
diff --git a/Tinycast/Features/Settings/Panes/SearchBarIconRow.swift b/Tinycast/Features/Settings/Panes/SearchBarIconRow.swift
new file mode 100644
index 0000000000000000000000000000000000000000..ee7eb0939b8dd7715d19c08d28af699797300f04
--- /dev/null
+++ b/Tinycast/Features/Settings/Panes/SearchBarIconRow.swift
@@ -0,0 +1,62 @@
+import SwiftUI
+
+/// tinycast-roseblud: Settings → General → Appearance, the launcher's search bar icon.
+struct SearchBarIconRow: View {
+    @AppStorage(SearchBarIcon.styleKey) private var style = SearchBarIcon.magnifier
+    @AppStorage(SearchBarIcon.emojiKey) private var emoji = SearchBarIcon.defaultEmoji
+    @State private var picking = false
+
+    var body: some View {
+        LabeledContent {
+            HStack(spacing: Theme.Spacing.sm) {
+                SearchBarIconTile(isSelected: style == .magnifier, help: "Search icon") {
+                    style = .magnifier
+                } label: {
+                    Image(systemName: PaletteMode.launcher.systemImage)
+                        .font(Theme.Typography.headerIcon)
+                        .symbolRenderingMode(.hierarchical)
+                        .foregroundStyle(.secondary)
+                }
+                SearchBarIconTile(isSelected: style == .emoji, help: "Choose an emoji") {
+                    style = .emoji
+                    picking = true
+                } label: {
+                    Text(verbatim: shownEmoji).font(Theme.Typography.headerIcon)
+                }
+                .popover(isPresented: $picking, arrowEdge: .bottom) {
+                    SearchBarEmojiPicker { picked in
+                        emoji = picked
+                        picking = false
+                    }
+                }
+            }
+        } label: {
+            SettingsRowTitle(.generalAppearance, "Search bar icon")
+        }
+    }
+
+    private var shownEmoji: String { SearchBarIcon.emoji(in: emoji) ?? SearchBarIcon.defaultEmoji }
+}
+
+/// One choice, drawn at the search bar's own icon size; the chosen one sits on a filled tile.
+private struct SearchBarIconTile<Label: View>: View {
+    let isSelected: Bool
+    let help: LocalizedStringKey
+    let action: () -> Void
+    @ViewBuilder let label: Label
+
+    private static var side: CGFloat { 36 }
+
+    var body: some View {
+        Button(action: action) {
+            label
+                .frame(width: Self.side, height: Self.side)
+                .background(
+                    RoundedRectangle(cornerRadius: Theme.Radius.barControl, style: .continuous)
+                        .fill(isSelected ? Theme.Colors.selection : Color.clear))
+                .contentShape(Rectangle())
+        }
+        .buttonStyle(.plain)
+        .help(help)
+    }
+}
