new file mode 100644
index 0000000000000000000000000000000000000000..d7025464386182c81aad58050ae6482db5f5438f
--- /dev/null
+++ b/Tests/SearchBarIconTests.swift
@@ -0,0 +1,28 @@
+import Foundation
+
+@main
+struct SearchBarIconTests {
+    static func main() {
+        func check<T: Equatable>(_ actual: T, _ expected: T, _ label: String) {
+            guard actual == expected else {
+                print("\(label): expected \(String(describing: expected)), got \(String(describing: actual))")
+                exit(1)
+            }
+        }
+
+        check(SearchBarIcon.emoji(in: "🚀"), "🚀", "a lone emoji is kept")
+        check(SearchBarIcon.emoji(in: "😀🚀"), "🚀", "a new pick replaces the old one")
+        check(SearchBarIcon.emoji(in: "🚀a"), "🚀", "letters typed after it are ignored")
+        check(SearchBarIcon.emoji(in: "abc"), nil, "plain text is no emoji")
+        check(SearchBarIcon.emoji(in: ""), nil, "nothing is no emoji")
+        check(SearchBarIcon.emoji(in: "1"), nil, "a digit is no emoji")
+        check(SearchBarIcon.emoji(in: "©"), nil, "a text-style symbol is no emoji")
+        check(SearchBarIcon.emoji(in: "❤️"), "❤️", "a variation selector makes one")
+        check(SearchBarIcon.emoji(in: "👍🏽"), "👍🏽", "a skin tone stays with its emoji")
+        check(SearchBarIcon.emoji(in: "👩‍💻"), "👩‍💻", "a ZWJ sequence is one emoji")
+        check(SearchBarIcon.emoji(in: "🇫🇷"), "🇫🇷", "a flag is one emoji")
+        check(SearchBarIcon.emoji(in: "1️⃣"), "1️⃣", "a keycap is one emoji")
+        check(SearchBarIcon.emoji(in: SearchBarIcon.defaultEmoji), SearchBarIcon.defaultEmoji, "the default is one")
+        print("search bar icon tests passed")
+    }
+}
diff --git a/Tinycast/Features/Launcher/Model/SearchBarIcon.swift b/Tinycast/Features/Launcher/Model/SearchBarIcon.swift
new file mode 100644
index 0000000000000000000000000000000000000000..a96ff4851ece5923032e3c71a931b21efe31da43
--- /dev/null
+++ b/Tinycast/Features/Launcher/Model/SearchBarIcon.swift
@@ -0,0 +1,23 @@
+import Foundation
+
+/// tinycast-roseblud: what the launcher's search bar shows at its left, before the query.
+enum SearchBarIcon: String, CaseIterable, Sendable {
+    case magnifier
+    case emoji
+
+    static let styleKey = "rosebludSearchBarIcon"
+    static let emojiKey = "rosebludSearchBarEmoji"
+    static let defaultEmoji = "😀"
+
+    /// The last emoji in `text`, so a new pick typed after the old one replaces it.
+    static func emoji(in text: String) -> String? {
+        text.last(where: isEmoji).map(String.init)
+    }
+
+    /// A lone scalar like `©` or `1` is only an emoji with presentation; a sequence is one outright.
+    private static func isEmoji(_ character: Character) -> Bool {
+        let scalars = character.unicodeScalars
+        guard let first = scalars.first, first.properties.isEmoji else { return false }
+        return first.properties.isEmojiPresentation || scalars.count > 1
+    }
+}
diff --git a/Tinycast/Features/Launcher/UI/LauncherSearchIcon.swift b/Tinycast/Features/Launcher/UI/LauncherSearchIcon.swift
